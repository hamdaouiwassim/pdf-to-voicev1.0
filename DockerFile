FROM node:20-slim AS base

WORKDIR /app

# Install system dependencies required for native packages
# - Poppler utilities for pdf-poppler (PDF to WebP conversion)
# - Build tools for native dependencies (sharp, etc.)
# - Libraries for image processing (sharp/libvips dependencies)
RUN apt-get update && apt-get install -y \
    poppler-utils \
    build-essential \
    python3 \
    libvips-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY package*.json ./

# Install Node.js dependencies
# Using npm ci for faster, reliable, reproducible builds
RUN npm ci --omit=dev

# Copy application source
COPY . .

# Set execute permissions on Rhubarb executable (if it exists)
# This fixes EACCES errors when trying to run the lip sync tool
RUN if [ -f /app/libsync/rhubarb ]; then \
        chmod +x /app/libsync/rhubarb && \
        echo "✓ Set execute permissions on Rhubarb executable"; \
    else \
        echo "⚠ Rhubarb executable not found at /app/libsync/rhubarb"; \
    fi

# Copy and set permissions for entrypoint script
COPY docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

# Configure runtime
ENV NODE_ENV=production
ENV PORT=3002

# Expose the application port
EXPOSE 3002

# Health check (optional - uncomment if needed)
# HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
#   CMD node -e "require('http').get('http://localhost:3002/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Use entrypoint script to run initialization scripts before starting the app
ENTRYPOINT ["/app/docker-entrypoint.sh"]

# Start the application
CMD ["npm", "start"]

